{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.env.windows": {
    "PATH": "${workspaceFolder}\\.tools\\node;C:\\Program Files\\Git\\cmd;${env:PATH}"
  },
  "git.path": "C:\\Program Files\\Git\\cmd\\git.exe",
  "git.useEditorAsCommitInput": false,
  "git.showCommitInput": true,
  "markdown.math.enabled": true,
  "markdown-preview-enhanced.mathRenderingOption": "KaTeX",
  "python.testing.unittestEnabled": true,
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    "tests",
    "-p",
    "test_*.py"
  ],
  "cmake.sourceDirectory": "${workspaceFolder}/native",
  "cmake.buildDirectory": "${workspaceFolder}/outputs/native",
  "cmake.configureOnOpen": false,
  "C_Cpp.default.compilerPath": "${workspaceFolder}/.tools/mingw64/bin/g++.exe",
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/outputs/native/compile_commands.json"
}
